# Copie este arquivo para .env e preencha com os dados do projeto no Supabase
# (Project Settings > API Keys).
# Use só a publishable key. A secret key ignora o RLS e não entra aqui.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
