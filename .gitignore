# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# serena (configuração local da ferramenta)
.serena/

# specs e planos do fluxo com agentes (locais)
docs/superpowers/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prints do mobile-qa (anexados à mão nos PRs)
docs/prints/
